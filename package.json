{
  "name": "ashen-contracts",
  "private": true,
  "version": "0.1.0",
  "description": "A narrative-driven browser idle RPG — full-stack portfolio project.",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "pnpm --parallel --filter=\"./apps/*\" dev",
    "build": "pnpm --recursive --filter=\"./apps/*\" build",
    "test": "pnpm --recursive --filter=\"./apps/*\" test",
    "lint": "pnpm --recursive --filter=\"./apps/*\" lint",
    "dev:api": "pnpm --filter api dev",
    "dev:web": "pnpm --filter web dev"
  }
}
