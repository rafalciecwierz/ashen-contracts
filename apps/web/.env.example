# Copy to .env.local (`cp .env.example .env.local`). The defaults work with `pnpm dev`.

# Base URL of the NestJS API, called server-side by route handlers and server components
API_URL=http://localhost:3001

# NODE_ENV is set by Next.js itself (`next dev` / `next build`); don't set it here.
# In production it marks the session cookie as Secure.
