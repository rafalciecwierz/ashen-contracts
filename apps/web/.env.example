# Copy to .env.local (`cp .env.example .env.local`). The defaults work with `pnpm dev`.

# src/config/serverEnv.ts validates these when the server starts. With an invalid
# value, it logs every problem and answers each request with a 500.

# Base URL of the NestJS API, called server-side by Server Actions and Server Components.
# Must be https:// in production (http:// is accepted only for localhost), because
# every request to it carries BFF_SECRET.
API_URL=http://localhost:3001

# Shared secret between this app's server side and the API: set the same value as
# BFF_SECRET in apps/api/.env (at least 32 characters). Generate one with
# `openssl rand -base64 32`.
# Server-only: no NEXT_PUBLIC_ prefix, so it never reaches the browser.
BFF_SECRET=

# NODE_ENV is set by Next.js itself (`next dev` / `next build`); don't set it here.
# In production it marks the session cookie as Secure.
