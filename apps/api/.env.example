# Copy to .env (`cp .env.example .env`). The defaults work with docker-compose.yml,
# except JWT_SECRET and BFF_SECRET, which you must set yourself.
# Validated at startup (src/config/env.schema.ts): the API refuses to start if a
# required variable is missing or invalid. Variables already set in the
# environment take precedence over this file.

# Matches the local PostgreSQL from docker-compose.yml (`docker compose up -d`)
DATABASE_URL="postgresql://ashen:ashen@localhost:5432/ashen_contracts?schema=public"

# Port the API listens on (default: 3001)
PORT=3001

# Secret used to sign JWTs, at least 32 characters. The placeholder below is
# deliberately too short, so the API refuses to start until you replace it.
# Generate one with `openssl rand -base64 32`.
JWT_SECRET="Use secure secret for JWT hash"

# Shared secret between the web app's BFF and the API, at least 32 characters.
# Set the same value as BFF_SECRET in apps/web/.env.local. Only requests that
# carry it may tell the API the player's IP for rate limiting. Like JWT_SECRET,
# the placeholder is too short on purpose: generate one with
# `openssl rand -base64 32`.
BFF_SECRET="Use the same secret as apps/web"

# Reverse proxies in front of the API (default: 0). Leave 0 locally; set 1
# behind the Railway or Render proxy.
TRUST_PROXY_HOPS=0

# Origin allowed to call the API from a browser (default: http://localhost:3000)
CORS_ORIGIN=http://localhost:3000

# Required: development | production | test. Swagger (/api) is served only in
# development. `nest start` does not set it, so every environment must.
NODE_ENV=development
