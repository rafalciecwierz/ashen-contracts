{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    // Off on purpose, as in the NestJS 12 CLI template (`nest new --strict`):
    // in Nest only DTOs have uninitialized fields, and the global
    // ValidationPipe guarantees them. See docs/DECISIONS.md #016.
    "strictPropertyInitialization": false,
    "noFallthroughCasesInSwitch": false
  }
}
