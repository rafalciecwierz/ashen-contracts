{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "noFallthroughCasesInSwitch": false
  },
  // dist/ is left out as the outDir; dist-e2e/ is the e2e tests' build (apps/e2e).
  "exclude": ["node_modules", "dist", "dist-e2e"]
}
