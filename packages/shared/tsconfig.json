{
  "compilerOptions": {
    "target": "ES2022",
    // Emits ES modules for Node: relative imports need their .js extension.
    // apps/api (CommonJS) loads them through require(esm), like NestJS 12.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    // Go to definition lands in src/, not in the emitted .d.ts.
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src"]
}
